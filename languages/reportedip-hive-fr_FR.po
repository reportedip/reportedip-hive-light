#: reportedip-hive.php
msgid "https://reportedip.com/products/wordpress-plugin/"
msgstr "https://reportedip.com/products/wordpress-plugin/"

#. Description of the plugin
#: reportedip-hive.php
msgid ""
"Lightweight brute-force login protection with optional community-powered IP "
"reputation checks."
msgstr ""
"Protection légère contre les attaques par force brute sur la connexion, avec"
" vérification facultative de la réputation des IP via la communauté."

#. Author of the plugin
#: reportedip-hive.php
msgid "Patrick Schlesinger"
msgstr "Patrick Schlesinger"

#. Author URI of the plugin
#: reportedip-hive.php
msgid "https://reportedip.com"
msgstr "https://reportedip.com"

