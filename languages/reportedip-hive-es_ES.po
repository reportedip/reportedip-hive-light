msgstr "https://reportedip.com/products/wordpress-plugin/"

#. Description of the plugin
#: reportedip-hive.php
msgid ""
"Lightweight brute-force login protection with optional community-powered IP "
"reputation checks."
msgstr ""
"Protección ligera de inicio de sesión contra ataques de fuerza bruta, con "
"consultas opcionales de reputación de IP impulsadas por la comunidad."

#. Author of the plugin
#: reportedip-hive.php
msgid "Patrick Schlesinger"
msgstr "Patrick Schlesinger"

#. Author URI of the plugin
#: reportedip-hive.php
msgid "https://reportedip.com"
msgstr "https://reportedip.com"

