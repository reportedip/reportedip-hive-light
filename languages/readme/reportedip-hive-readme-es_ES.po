msgstr "URL: <code>https://reportedip.com/wp-json/reportedip/v2/report</code>"

#. Found in description list item.
msgid ""
"Data NOT sent: usernames, passwords, cookies, server identifiers, domain "
"name"
msgstr ""
"Datos que NO se envían: nombres de usuario, contraseñas, cookies, "
"identificadores del servidor, nombre de dominio"

#. Found in description list item.
msgid "Data sent: only the source IP address of the current login attempt"
msgstr ""
"Datos enviados: solo la dirección IP de origen del intento de inicio de "
